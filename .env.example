// ===== Backend =====
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/condomini

# Segreti: in produzione genera valori forti (openssl rand -hex 48)
JWT_ACCESS_SECRET=cambia-questo-secret-access-in-produzione
JWT_REFRESH_SECRET=cambia-questo-secret-refresh-in-produzione
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Origini consentite per CORS (separate da virgola)
CORS_ORIGINS=http://localhost:5173

# ===== Email (Brevo) =====
# Base del frontend: serve a comporre il link di conferma inviato nell'email.
URL_FRONTEND=http://localhost:5173
# Base pubblica di questa API. Va dichiarata solo in produzione, dove frontend e
# API hanno origini diverse: senza, gli URL degli allegati restano relativi e il
# frontend li chiederebbe al sito statico ricevendone un 404.
URL_API=
# Chiave privata: va nel file .env, mai qui e mai nel repository.
# Senza BREVO_API_KEY l'invio è disattivato e l'utente viene comunque creato.
BREVO_API_KEY=
# Mittente deve essere un mittente verificato su Brevo, altrimenti l'email
# viene rifiutata. In alternativa si usa l'API /v3/smtp/email con il mittente
# predefinito del tuo account.
BREVO_MITTENTE_EMAIL=noreply@tuodominio.it
BREVO_MITTENTE_NOME=Steward
# Ore entro cui il link di conferma resta valido
CONFERMA_EMAIL_TTL_ORE=72

# Admin bootstrap (usato solo dal seed)
SEED_ADMIN_EMAIL=admin@condomini.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_SUPERADMIN_EMAIL=superadmin@condomini.local
SEED_SUPERADMIN_PASSWORD=SuperAdmin123!

# ===== Frontend =====
VITE_API_URL=/api
